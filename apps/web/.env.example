# PA API base URL used by the server-side /api/pa proxy.
# Default when unset: http://127.0.0.1:8010
PA_API_URL=http://127.0.0.1:8010

# Web 端（JS API）高德地图配置。仅用于浏览器，不能视为保密存储。
# 必须使用 Web 端 JS API Key 及其配套安全密钥，不能填写“Web 服务”Key。
# 当前两项仅适用于本机开发；公网部署前必须切换到后端 fixed serviceHost，
# 不得继续通过 NEXT_PUBLIC_* 把安全密钥编译进浏览器资源。
NEXT_PUBLIC_AMAP_JS_KEY=
NEXT_PUBLIC_AMAP_SECURITY_CODE=

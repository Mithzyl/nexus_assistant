# Personal Assistant API configuration
ASSISTANT_ENVIRONMENT=development
ASSISTANT_DATABASE_URL=sqlite+aiosqlite:///./assistant-dev.db

# NexusPilot application boundary
ASSISTANT_NEXUS_BASE_URL=http://127.0.0.1:8001
ASSISTANT_NEXUS_APPLICATION_ID=personal_assistant
ASSISTANT_NEXUS_APPLICATION_TOKEN=replace-with-32-plus-character-token

# Current NexusPilot App Runs require an explicit general-agent definition and
# role bindings. These are server-side deployment choices; clients never see or
# send provider/model values. Adjust them to models enabled in NexusPilot.
ASSISTANT_NEXUS_WORKFLOW_NAME=general_agent
ASSISTANT_NEXUS_WORKFLOW_VERSION=1.0.0
ASSISTANT_NEXUS_EXECUTION_PROFILE=general_tools_v1
ASSISTANT_NEXUS_REVIEW_POLICY=never
# Current local NexusPilot opencode registration. Replace the model if the
# deployment registers a different opencode model.
ASSISTANT_NEXUS_ROLE_BINDINGS_JSON={"controller":{"provider":"opencode","model":"deepseek-v4.1-flash"}}
ASSISTANT_NEXUS_WORKFLOW_START_TIMEOUT_SECONDS=20

# Credential NexusPilot presents when calling this service's business tools
ASSISTANT_TOOL_CALLBACK_TOKEN=replace-with-another-32-plus-character-token

# Local session lifetime
ASSISTANT_SESSION_TOKEN_TTL_SECONDS=86400

# Local development only; use migrations in deployment
ASSISTANT_ALLOW_SCHEMA_CREATE=true

# ---------------------------------------------------------------------------
# Commute reminders
# ---------------------------------------------------------------------------
# mock: development only, persists provider names as `mock` and never contacts
# Apple. live: real WeatherKit + Maps Server API + APNs. Production refuses mock
# and refuses live mode with any credential missing.
ASSISTANT_COMMUTE_PROVIDER_MODE=mock
ASSISTANT_COMMUTE_MOCK_RAIN_PROBABILITY=0.2
ASSISTANT_COMMUTE_MOCK_ETA_SECONDS=1800
ASSISTANT_COMMUTE_MOCK_PUSH_RESULT=accepted
ASSISTANT_COMMUTE_MOCK_FAIL_WEATHER=false
ASSISTANT_COMMUTE_MOCK_FAIL_ETA=false

# WeatherKit REST: team id / key id / service id and the .p8 key path.
# The JWT is minted in memory and never logged.
ASSISTANT_COMMUTE_WEATHER_TEAM_ID=
ASSISTANT_COMMUTE_WEATHER_KEY_ID=
ASSISTANT_COMMUTE_WEATHER_SERVICE_ID=com.example.assistant.weather
ASSISTANT_COMMUTE_WEATHER_PRIVATE_KEY_PATH=
ASSISTANT_COMMUTE_WEATHER_LANGUAGE=zh-Hans
ASSISTANT_COMMUTE_WEATHER_BASE_URL=https://weatherkit.apple.com

# Apple Maps Server API: separate team/key/Maps ID. This is NOT the WeatherKit
# JWT. The provider exchanges its own JWT for a 30-minute access token.
ASSISTANT_COMMUTE_MAPS_TEAM_ID=
ASSISTANT_COMMUTE_MAPS_KEY_ID=
ASSISTANT_COMMUTE_MAPS_ID=com.example.assistant.maps
ASSISTANT_COMMUTE_MAPS_PRIVATE_KEY_PATH=
ASSISTANT_COMMUTE_MAPS_BASE_URL=https://maps-api.apple.com

# APNs alert provider. Topic and environment are server-owned; clients cannot
# choose them. Use sandbox for development devices and production only in prod.
ASSISTANT_COMMUTE_APNS_TEAM_ID=
ASSISTANT_COMMUTE_APNS_KEY_ID=
ASSISTANT_COMMUTE_APNS_PRIVATE_KEY_PATH=
ASSISTANT_COMMUTE_APNS_TOPIC=com.example.assistant
ASSISTANT_COMMUTE_APNS_ENVIRONMENT=sandbox
# Optional override for tests/proxies; leave empty for Apple's real host.
ASSISTANT_COMMUTE_APNS_HOST=

# Optional model wording endpoint. Missing URL means template copy (supported).
# It must be a controlled backend endpoint, not a direct provider API key in App.
ASSISTANT_COMMUTE_ADVICE_MODEL_URL=
ASSISTANT_COMMUTE_ADVICE_MODEL_TOKEN=
ASSISTANT_COMMUTE_ADVICE_MODEL_TIMEOUT_SECONDS=3

# Product defaults (not Apple limits)
ASSISTANT_COMMUTE_CHECK_INTERVAL_MINUTES=10
# Timed weather refresh and timed AI analysis are independent. Startup never
# enables paid analysis; weather-only checks never create or modify an advisory.
ASSISTANT_COMMUTE_AUTO_WEATHER_ENABLED=true
ASSISTANT_COMMUTE_AUTO_AI_ENABLED=false
ASSISTANT_COMMUTE_MAX_AUTO_REMINDERS_PER_DAY=2
ASSISTANT_COMMUTE_MIN_REMINDER_GAP_MINUTES=15
ASSISTANT_COMMUTE_ETA_FRESHNESS_SECONDS=600
ASSISTANT_COMMUTE_WEATHER_FRESHNESS_SECONDS=3600
ASSISTANT_COMMUTE_SCHEDULER_POLL_SECONDS=20
ASSISTANT_COMMUTE_WORKER_POLL_SECONDS=3
ASSISTANT_COMMUTE_LEASE_SECONDS=90
ASSISTANT_COMMUTE_JOB_LEASE_SECONDS=180
ASSISTANT_COMMUTE_OUTBOX_MAX_ATTEMPTS=4
ASSISTANT_COMMUTE_DATA_RETENTION_DAYS=30

# Bark is bound by each logged-in account through the App; there is no
# server-wide owner or device-key environment fallback.
